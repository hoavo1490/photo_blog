---
import { defaultAuthor } from '../data/nav';
const author = defaultAuthor; // future: derive from tenant settings
const thisYear = new Date().getUTCFullYear();
---
<footer>
  <span>&copy; {thisYear} {author}</span>
  <nav aria-label="Footer">
    <a href="/atom.xml" type="application/rss+xml">RSS</a>
  </nav>
</footer>
