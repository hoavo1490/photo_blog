---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import * as posts from '../lib/db/posts';
import * as topics from '../lib/db/topics';
import * as tags from '../lib/db/tags';
import { batchCoverImagesFor } from '../lib/render';
import { firstParagraph } from '../lib/markdown';
import { variantUrlForKey } from '../lib/r2/images';
import { resolveCanonicalOrigin, buildWebSiteJsonLd, buildPersonJsonLd, defaultAuthorProfile, asGraph } from '../lib/seo';
import { defaultSiteName } from '../data/nav';

const tenant = Astro.locals.tenant!;
const driver = Astro.locals.db!;
const env_ = env as unknown as { R2_PUBLIC_BASE?: string; R2_DEV_BASE?: string };

const all = await posts.listPublished(driver, { siteId: tenant.id, limit: 200 });
const [coverByPost, topicList, tagNamesByPost] = await Promise.all([
  batchCoverImagesFor(driver, tenant.id, all, env_),
  topics.listForSite(driver, { siteId: tenant.id }),
  tags.listNamesForPosts(driver, { siteId: tenant.id, postIds: all.map((p) => p.id) }),
]);
const topicNameById = new Map(topicList.map((t) => [t.id, t.name]));

type Card = {
  post: typeof all[number];
  cover: string;
  desc: string;
  label: string | null;
  r2Key: string | null;
  variantWidths: number[];
  hasAvif: boolean;
};
const cards: Card[] = [];
for (const p of all) {
  const info = coverByPost.get(p.id);
  if (!info) continue;
  // Generous cap: the row clamps to 3-4 lines in CSS, so the text must
  // overflow the clamp for it to end in an ellipsis rather than stop
  // mid-sentence. firstParagraph's 200-char default is sized for meta tags.
  const desc = p.description ?? firstParagraph(p.body, 600) ?? '';
  // Topic is the post's single category; fall back to its first tag.
  const label = (p.topicId ? topicNameById.get(p.topicId) : undefined)
    ?? tagNamesByPost.get(p.id)?.[0]
    ?? null;
  cards.push({
    post: p, cover: info.url, desc, label,
    r2Key: info.r2Key, variantWidths: info.variantWidths, hasAvif: info.hasAvif,
  });
}

const byYear = new Map<number, Card[]>();
for (const c of cards) {
  const y = c.post.publishedAt!.getUTCFullYear();
  const list = byYear.get(y) ?? [];
  list.push(c);
  byYear.set(y, list);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);

// og:image = latest post's cover so social shares of the home page get
// a real image preview instead of a blank card.
const latestCover = cards[0]?.cover;
const latest = cards[0];
// Kept in lock-step with PostCard.astro's sizesAttr so the preload
// and the eventual <picture> pick the same variant -- otherwise the
// browser fires two requests for the LCP candidate.
const lcpSizes = '(max-width: 480px) 110px, 180px';
const lcpSrcset = latest && latest.r2Key && latest.variantWidths.length > 0
  ? [
      ...latest.variantWidths.map((w) => `${variantUrlForKey(latest.r2Key!, w, env_)} ${w}w`),
      `${latest.cover} 1600w`,
    ].join(', ')
  : undefined;
const lcpWebpSrcset = latest && latest.r2Key && latest.variantWidths.length > 0
  ? latest.variantWidths
      .map((w) => `${variantUrlForKey(latest.r2Key!, w, env_).replace(/\.jpg$/, '.webp')} ${w}w`)
      .join(', ')
  : undefined;
const lcpAvifSrcset = latest && latest.r2Key && latest.hasAvif && latest.variantWidths.length > 0
  ? latest.variantWidths
      .map((w) => `${variantUrlForKey(latest.r2Key!, w, env_).replace(/\.jpg$/, '.avif')} ${w}w`)
      .join(', ')
  : undefined;
// Stable homepage title + description. Previously the description
// pulled from `latestDesc` (first paragraph of the most recent post),
// which changed every publish and tripped Google's "is this a real
// description?" heuristic -- the SERP snippet started auto-stitching
// from random post bodies. The hardcoded copy below tells Google what
// the SITE is about, so the snippet stays consistent across publishes.
const HOME_TITLE = 'photo journal & notes by Rio';
const HOME_DESCRIPTION = 'Photo journal & notes by Rio — travel, music, and everyday moments from Vietnam and beyond.';
---
<BaseLayout
  title={HOME_TITLE}
  description={HOME_DESCRIPTION}
  image={latestCover}
  lcpImage={latest ? {
    src: latest.cover,
    srcset: lcpSrcset,
    webpSrcset: lcpWebpSrcset,
    avifSrcset: lcpAvifSrcset,
    sizes: lcpSrcset ? lcpSizes : undefined,
  } : undefined}
  jsonLd={asGraph([
    buildWebSiteJsonLd({
      siteUrl: resolveCanonicalOrigin(tenant, Astro.url),
      siteName: tenant.name ?? defaultSiteName,
      description: HOME_DESCRIPTION,
      inLanguage: 'vi-VN',
    }),
    buildPersonJsonLd(resolveCanonicalOrigin(tenant, Astro.url), defaultAuthorProfile),
  ])}
>
  <div class="home-wrap">
    <div id="gallery" class="gallery">
      {years.map(([year, list]) => (
        <section class="year-section" data-year={year}>
          <div class="section-header-wrapper">
            <h2 class="section-title">{year}</h2>
          </div>
          <div class="post-list">
            {list.map((c) => {
              const i = cards.findIndex((x) => x.post.id === c.post.id);
              return (
                <PostCard
                  post={c.post}
                  cover={c.cover}
                  description={c.desc}
                  label={c.label}
                  priority={i === 0}
                  aboveFold={i > 0 && i < 6}
                  variantWidths={c.variantWidths}
                  r2Key={c.r2Key ?? undefined}
                  r2Env={env_}
                  hasAvif={c.hasAvif}
                />
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
